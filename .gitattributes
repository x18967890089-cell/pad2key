# PowerShell 脚本保持 CRLF，Windows PowerShell 5.1 按此习惯处理
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 其余文本统一 LF
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# 二进制不要做换行转换
*.dll   binary
*.png   binary
*.gif   binary
*.zip   binary
